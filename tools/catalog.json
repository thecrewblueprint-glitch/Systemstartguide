      "activation": "owner-consented"
    },
    {
      "kind": "calendar",
      "use": "events and deadlines",
      "default_scope": "read-only",
      "activation": "owner-consented"
    },
    {
      "kind": "email",
      "use": "request intake and drafts",
      "default_scope": "no access",
      "activation": "owner-consented"
    },
    {
      "kind": "runtime",
      "use": "local tests and document generation",
      "default_scope": "isolated local files",
      "activation": "available only when host supports it"
